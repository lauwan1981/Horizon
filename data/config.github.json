{
  "ai": {
    "analysis_concurrency": 5,
    "api_key_env": "OPENAI_API_KEY",
    "base_url": "https://openrouter.ai/api/v1",
    "enrichment_concurrency": 5,
    "languages": [
      "zh",
      "en"
    ],
    "max_tokens": 8192,
    "model": "nvidia/nemotron-3.5-lightning:free",
    "provider": "openai",
    "temperature": 0.3,
    "throttle_sec": 1
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "category_groups": {},
    "default_group": "other",
    "default_group_limit": null,
    "max_items": 20,
    "profile_order": [
      "tech-news",
      "tech-blog",
      "finance-news"
    ]
  },
  "processing": {
    "default_profile": "tech-news",
    "profile_settings": {
      "finance-news": {
        "threshold": 7.0,
        "topic_dedup": true
      },
      "tech-blog": {
        "threshold": 4.0,
        "topic_dedup": false
      },
      "tech-news": {
        "threshold": 5.0,
        "topic_dedup": true
      }
    },
    "profiles_dir": "profiles"
  },
  "sources": {
    "github": [],
    "google_news": {
      "category": "yangmao",
      "country": "CN",
      "enabled": true,
      "language": "zh",
      "max_results": 50,
      "profile": "tech-news",
      "query": "AI 免费额度"
    },
    "hackernews": {
      "enabled": false
    },
    "reddit": {
      "enabled": false
    },
    "rss": [
      {
        "category": "yangmao",
        "enabled": true,
        "name": "赛博鸡蛋-即将截止",
        "profile": "tech-news",
        "url": "https://jidan.si/rss/expiring.xml"
      },
      {
        "category": "yangmao",
        "enabled": true,
        "name": "白嫖计",
        "profile": "tech-news",
        "url": "https://baipiaoji.com/feed.xml"
      },
      {
        "category": "yangmao",
        "enabled": true,
        "name": "AIHot-Token羊毛",
        "profile": "tech-news",
        "url": "https://aihot.news/feed.xml"
      }
    ],
    "telegram": {
      "enabled": false
    },
    "twitter": {
    "enabled": true,
    "users": [],
    "keywords": ["免费额度 OR 免费领取 OR 羊毛 OR \"free credits\" OR \"free tier\""],
    "fetch_limit": 10,
    "fetch_reply_text": false,
    "max_replies_per_tweet": 3,
    "max_tweets_to_expand": 10,
    "reply_min_likes": 5,
    "profile": "tech-news"
  }
  },
  "webhook": {
    "enabled": false
  }
}
